# 在线考试平台 - 环境变量示例
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不要提交。
# 启动脚本前先 source 本文件： set -a; source .env; set +a

# ── 数据库（必需）──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exam_platform
DB_USERNAME=root
DB_PASSWORD=

# ── JWT（必需）──
# 至少 32 字节，生成方式：openssl rand -base64 48
# 留空则服务拒绝启动（见 JwtUtil#validateSecret）
JWT_SECRET=

# ── CORS（可选，逗号分隔；默认仅允许 localhost）──
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── AI 服务（可选，app.ai.enabled=true 时才生效）──
AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_API_KEY=
