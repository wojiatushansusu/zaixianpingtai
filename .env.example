# 在线考试平台 - 环境变量示例
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不要提交。
# 启动脚本前先 source 本文件： set -a; source .env; set +a
#
# 用 docker compose 部署时，只有下面「必需」两项会拦住启动；
# 其余留空也能跑起来——但 AI 相关功能会整体不可用。

# ── 数据库（必需）──
# compose 模式下这些值由 docker-compose.yml 直接指定，不用在这里填；
# 只在本机直连数据库运行 jar 时才需要。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exam_platform
DB_USERNAME=root
DB_PASSWORD=

# ── JWT（必需）──
# 至少 32 字节，生成方式：openssl rand -base64 48
# 留空则服务拒绝启动（见 JwtUtil#validateSecret）
# 注意：换掉这个值等于让所有已登录用户掉线，部署后别再改。
JWT_SECRET=

# ── CORS（可选）──
# 前端和接口同域（都在 nginx 后面）时 CORS 不生效，留默认即可。
# 只有在「前端域名 ≠ 接口域名」时才需要填写，逗号分隔。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Redis（compose 模式下无需填写）──
# 容器里必须指向服务名，docker-compose.yml 已经设成 redis。
# 只有把后端跑在容器外时才需要改这两个。
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ── AI 服务（可选，但这是本项目的核心能力）──
# 不填 AI_API_KEY 时 AI_ENABLED 即使为 true 也没用，出卷 / 错题讲解 / 知识点补标全部不可用。
# 阿里云百炼（OpenAI 兼容）默认地址如上；换自建模型改 AI_API_URL 即可。
AI_ENABLED=false
AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_API_KEY=
